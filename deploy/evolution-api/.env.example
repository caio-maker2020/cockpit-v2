# =============================================================================
# Evolution API v2 — env vars do Railway
# Cockpit v2 / Sal Express
# =============================================================================
# Setar TODAS no Railway antes do primeiro deploy.
# Docs oficiais: https://doc.evolution-api.com/
#
# Após o deploy, copiar BASE_URL pública (https://<projeto>.up.railway.app)
# e a AUTHENTICATION_API_KEY pros secrets do Supabase como:
#   EVOLUTION_BASE_URL  = <url Railway>
#   EVOLUTION_GLOBAL_APIKEY = <mesmo valor de AUTHENTICATION_API_KEY abaixo>
# =============================================================================

# ----- Server -----
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://CHANGE-ME.up.railway.app

# ----- Auth -----
# Gerar com: openssl rand -hex 32
AUTHENTICATION_API_KEY=CHANGE-ME-32-char-hex
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ----- Database (Postgres via Railway plugin) -----
# Recomendado: criar plugin Postgres no mesmo projeto Railway,
# referenciar via ${{Postgres.DATABASE_URL}}
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=${{Postgres.DATABASE_URL}}?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# ----- Cache (Redis via Railway plugin opcional, recomendado em prod) -----
CACHE_REDIS_ENABLED=false
CACHE_REDIS_URI=${{Redis.REDIS_URL}}
CACHE_REDIS_PREFIX_KEY=evolution_cockpit
CACHE_LOCAL_ENABLED=true

# ----- Logs -----
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error

# ----- Webhook global (opcional, integrar com Cockpit) -----
# Quando quisermos receber status de entrega/leitura no Cockpit, apontar
# pro endpoint na edge function (criar webhook-evolution depois).
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# ----- QR Code -----
QRCODE_LIMIT=10
QRCODE_COLOR=#000000

# ----- Telemetria desligada -----
TELEMETRY=false
