node_modules/

# Segredos — regra abrangente (2026-08-06).
# Motivo: o arquivo veio da nuvem como `env.download` e NAO casava com nenhum
# padrao antigo (`.env`, `.env.local`, `.env.*.local`), ficando exposto a um
# `git add .`. Agora ignora QUALQUER nome com "env" que carregue segredo, e so
# libera os `.env.example` por excecao explicita.
.env
.env.*
*.env
env.*
env
!.env.example
!**/.env.example

dist/
build/
__pycache__/
*.pyc
.DS_Store
*.log
.vscode/
.idea/
.turbo/
.next/
.supabase/
coverage/
.vitest/
*.tsbuildinfo

# Backup do v1 — referência local, não versionar
../backup_lovable/
backup_lovable/
_backup_v1/

# Docs exportados (gerados de docs/*.md via pandoc)
docs/exports/

# Claude Code — settings locais por usuário (não versionar)
.claude/settings.local.json

# Dumps descartáveis do lote espécie CURVA F (2026-06-12)
data/curva_f_cnpjs.json
data/curva_f_unicos.json
data/curva_f_*_progress.json
data/curva_f_run.log

# Backups locais de pre-migration (não versionar — snapshots de dados sensíveis)
backup_pre_mig_*/

# Dados operacionais (CSVs com contatos, reports curva-F, etc.)
data/

# Dev artifacts — relatórios curva_f, scripts ad-hoc, CSVs operacionais
data/

# macOS Finder metadata (Icon\r)
Icon?
.vercel
