# Supabase (projeto novo do v2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Caio/Carlos: role postgres (migra + deploya). Analista só-leitura (Duilio):
# role leitura_duilio (mig 411) — ver docs/RITUAL_DEPLOY.md §0-bis. NUNCA
# entregar SUPABASE_ACCESS_TOKEN a quem só lê: não tem modo leitura.
SUPABASE_DB_URL=postgresql://postgres:...

# Anthropic
# Produção: vive SÓ no secret das edge functions (supabase secrets). Não precisa
# estar no .env.local de ninguém — o ritual-env.sh nem exporta (INV-167).
ANTHROPIC_API_KEY=
# Evals/scripts locais (replay-regras, smoke do chat, ensaios): chave SEPARADA,
# criada no console da Anthropic com teto de gasto próprio (INV-167, 02/10/2026).
ANTHROPIC_API_KEY_EVALS=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sal-express

# Resend (e-mail saída)
RESEND_API_KEY=

# Postmark (e-mail entrada — webhook inbound)
POSTMARK_INBOUND_TOKEN=

# SSW (TMS)
SSW_DOMAIN=SEP
SSW_USERNAME=
SSW_PASSWORD=
SSW_CNPJ_EDI=

# Bastão (espelho de ocorrências)
BASTAO_SUPABASE_URL=
BASTAO_SUPABASE_ANON_KEY=

# Roteirizador Inteligente — ponte Roteirizador ↔ Cockpit (ADR 0034).
# Base SEM o sufixo /v3/ponte. Qualquer uma vazia = ponte desligada (no-op).
# O token é só da ponte (RI_PONTE_TOKEN no servidor do Roteirizador).
ROTEIRIZADOR_API_URL=
ROTEIRIZADOR_PONTE_TOKEN=

# Feature flags
FEATURE_AGENT_REENTREGA_ENABLED=false
FEATURE_AGENT_DEVOLUCAO_ENABLED=false
FEATURE_AUTO_APPROVAL_LOW_RISK=false
